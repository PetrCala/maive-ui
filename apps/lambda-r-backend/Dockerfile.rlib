# ─────────────────────────────────────────────────────────
# R LIBRARY BASE (Amazon Linux 2023): pre-baked libs
# Produces: rlib:al2023-r4.4.1-maive-<hash>
# ─────────────────────────────────────────────────────────

########## Stage 1: build R and compile packages ##########
FROM public.ecr.aws/docker/library/amazonlinux:2023 AS build

ARG R_VERSION
ARG MAIVE_TAG
ARG GITHUB_PAT
ARG GITHUB_USERNAME

ENV PATH="/usr/local/bin:${PATH}"
# Speed-ups / stable installs
ENV MAKEFLAGS="-j2"
ENV R_REMOTES_NO_ERRORS_FROM_WARNINGS=true
ENV R_INSTALL_STAGED=false

# Build deps (headers + toolchain) and ensure libcurl (not minimal).
# cmake is required by RcppParallel 6.x, which configures TBB through it.
RUN dnf -y update && dnf -y install \
    gcc gcc-c++ gcc-gfortran make cmake \
    tar gzip wget which \
    perl perl-core \
    zlib-devel bzip2 bzip2-devel xz xz-devel pcre2-devel \
    readline-devel libcurl-devel libxml2-devel openssl-devel \
    libsodium-devel \
    libicu-devel \
    # For plotting
    freetype-devel fontconfig-devel harfbuzz-devel fribidi-devel libpng-devel libjpeg-turbo-devel pkgconf-pkg-config libtiff-devel libwebp-devel \
 && dnf clean all

# Build & install R from source
RUN cd /tmp \
 && wget -q https://cran.r-project.org/src/base/R-4/R-${R_VERSION}.tar.gz \
 && tar -xzf R-${R_VERSION}.tar.gz \
 && cd R-${R_VERSION} \
 && ./configure --enable-R-shlib --with-readline --with-x=no --prefix=/usr/local \
 && make -j"$(nproc)" && make install \
 && cd / && rm -rf /tmp/R-${R_VERSION}* \
 && /usr/local/bin/R --version

# Optional GitHub auth for pak
RUN if [ -n "${GITHUB_PAT:-}" ]; then \
      mkdir -p /usr/local/lib/R/etc && \
      echo "GITHUB_PAT=${GITHUB_PAT}" >> /usr/local/lib/R/etc/Renviron.site && \
      echo "GITHUB_USERNAME=${GITHUB_USERNAME}" >> /usr/local/lib/R/etc/Renviron.site; \
    fi

# Install pak (fast installer)
RUN R -q -e "install.packages('pak', repos='https://cran.rstudio.com')"

# Install CRAN packages from list. Entries may carry a pak version ref
# (pkg@version). phacking (the RTMA implementation, #489), clubSandwich (the
# cluster-robust covariance behind every MAIVE standard error and the CR2
# variance and Satterthwaite degrees of freedom behind every RDT interval,
# #574/#576) and metafor (#574) are pinned that way, so a rebuilt image keeps
# shipping the versions the results and the exported reproducibility packages
# depend on. The UI mirrors the phacking and clubSandwich pins in
# CONST.REPRODUCIBILITY.DEFAULTS, with a drift test (rPackagePins.test.ts)
# tying the two together.
COPY r_scripts/r-packages.txt /tmp/r-packages.txt
RUN R -q -e "pkgs <- readLines('/tmp/r-packages.txt'); pak::pkg_install(pkgs)"

# Install the MAIVE package. The pinned packages above are installed first and
# this step must leave them alone: with upgrade = FALSE pak installs MAIVE plus
# any dependency that is missing or older than MAIVE's DESCRIPTION requires,
# and keeps an installed dependency that already satisfies it. upgrade = TRUE
# would instead refresh every dependency to the newest CRAN release, which is
# exactly how the clubSandwich pin got undone (#574/#576).
RUN R -q -e "pak::pkg_install('PetrCala/MAIVE@${MAIVE_TAG}', upgrade = FALSE)"

# Fail the build if anything above replaced a pinned package (a future MAIVE
# release requiring a newer clubSandwich would do that). The pin then has to be
# bumped in r-packages.txt and in the UI constant together, instead of the
# image quietly shipping a version the reproducibility packages do not name.
RUN R -q -e "pins <- grep('@', readLines('/tmp/r-packages.txt'), value = TRUE); \
  for (pin in pins) { \
    parts <- strsplit(pin, '@', fixed = TRUE)[[1]]; \
    installed <- as.character(packageVersion(parts[1])); \
    if (!identical(installed, parts[2])) \
      stop(parts[1], ' is ', installed, ' but r-packages.txt pins ', parts[2]); \
  }; \
  cat('Pinned packages verified:', paste(pins, collapse = ', '), '\n')"

# Prove what's installed
RUN R -q -e "writeLines(apply(installed.packages()[,c('Package','Version')],1,paste,collapse='@'))" > /root/rlib-manifest.txt


########## Stage 2: minimal runtime base ##########
FROM public.ecr.aws/docker/library/amazonlinux:2023 AS rlib

ARG R_VERSION

# Runtime libs only (keep libcurl-minimal from base; do NOT install libcurl)
RUN dnf -y update \
 && dnf -y install \
      zlib bzip2-libs xz-libs pcre2 readline \
      libxml2 openssl-libs \
      libsodium \
      libgcc libgfortran \
      libwebp \
 && dnf clean all

# Bring in R & the preinstalled libraries
COPY --from=build /usr/local /usr/local
COPY --from=build /root/rlib-manifest.txt /opt/rlib-manifest.txt

ENV PATH="/usr/local/bin:${PATH}"

# Final image label for traceability
LABEL r.version="${R_VERSION}" base="al2023" rlib.manifest="/opt/rlib-manifest.txt"
